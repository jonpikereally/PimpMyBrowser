{
  "manifest_version": 3,
  "name": "PimpMyBrowser",
  "version": "1.0.0",
  "description": "An all-purpose toolbox of small browser tweaks. Turn each one on or off from the toolbar popup.",
  "homepage_url": "https://github.com/jonpikereally/PimpMyBrowser",
  "minimum_chrome_version": "120",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "PimpMyBrowser",
    "default_popup": "app/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "src/background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "css": ["modules/hide-playables/hide.css"],
      "js": ["modules/hide-playables/content.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": ["storage", "contextMenus", "alarms"]
}
